# Neon Postgres connection string (pooled). Leave unset to run the site with
# the vote system disabled: the build still succeeds, polls render their empty
# copy, and voting reports itself unavailable.
DATABASE_URL=

# HMAC key for the signed `pu_vid` voter cookie. Any long random string.
# Rotating it resets every voter identity (old votes stay, they just orphan).
VOTE_SECRET=

# Salt mixed into sha256(ip) before storage. The raw IP is never persisted.
IP_SALT=
