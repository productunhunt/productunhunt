---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { SITE, NAV_ITEMS, FOOTER_ITEMS, REPO_URL } from '../consts';
import { locale, navLabel, t } from '../i18n';
import CodeCopy from '../components/CodeCopy.astro';
import SocialLinks from '../components/SocialLinks.astro';

/** Article-only Open Graph metadata. Mirrors what the page's JSON-LD says —
 *  a crawler that reads one and not the other must not get two answers. */
export interface ArticleMeta {
  publishedTime: string;
  modifiedTime?: string;
  author: string;
  tags: readonly string[];
}

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
  /** Alt text for the share card. Defaults to the fallback card's. */
  imageAlt?: string;
  /** `false` keeps the page out of search results while still letting the
   *  crawler follow its links (search, 404, thin tag archives). Pages opted
   *  out here must also be filtered out of the sitemap in astro.config.mjs. */
  indexable?: boolean;
  article?: ArticleMeta;
}

const siteName = SITE.title;

const {
  title = siteName,
  description = SITE.description,
  ogType = 'website',
  image,
  imageAlt = SITE.ogImageAlt,
  indexable = true,
  article,
} = Astro.props;

// `Astro.site` comes from `site` in astro.config.mjs; fall back to the
// request URL during dev so canonical/OG links still resolve.
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
// `max-image-preview:large` opts the share cards into full-size previews; the
// noindex form drops it because there is no preview to size.
const robots = indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow';
const imageType = imageURL.pathname.endsWith('.png') ? 'image/png' : 'image/jpeg';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    {/* Google's favicon crawler ignores SVG and wants better than 48×48. */}
    <link rel="icon" type="image/png" href={withBase('/favicon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
    <title>{fullTitle}</title>

    {/* Astro comment syntax — an HTML comment here would ship on every page. */}
    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {/* Open Graph wants `language_TERRITORY`; `<html lang>`'s bare `en` is invalid here. */}
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          {article.modifiedTime && (
            <meta property="article:modified_time" content={article.modifiedTime} />
          )}
          <meta property="article:author" content={article.author} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label={t('nav.brandHome', { site: siteName })}>
        <span class="brand-mark" aria-hidden="true"></span>
        {
          /* §2: the spaced-caps lockup is the masthead's alone. `SITE.title`
            still supplies <title> and og:site_name, where it would misread. */
        }
        <span class="wordmark">{SITE.wordmark}</span>
      </a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          NAV_ITEMS.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {navLabel(item)}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.footerText}</p>
      <nav class="footer-links" aria-label={t('footer.label')}>
        {FOOTER_ITEMS.map((item) => <a href={withBase(item.href)}>{navLabel(item)}</a>)}
      </nav>
      <SocialLinks />
      <p class="footer-colophon">
        Proudly vibecoded with Claude and Codex — and even Gemini in a few places. If you find <a
          href={REPO_URL}>the repository</a
        > absurd, or a bug somewhere, well, use your Claude to open a PR.
      </p>
    </footer>

    <CodeCopy />
  </body>
</html>
