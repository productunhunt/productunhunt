---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { t } from '../i18n';
---

<BaseLayout title={t('notFound.title')} description={t('notFound.description')} indexable={false}>
  <section class="hero section">
    <p class="eyebrow">{t('notFound.eyebrow')}</p>
    <h1>{t('notFound.heading')}</h1>
    <p class="lead">{t('notFound.lead')}</p>
    <div class="action-row" aria-label={t('notFound.linksLabel')}>
      <a class="button" href={withBase('/')}>{t('notFound.home')}</a>
      <a class="text-link" href={withBase('/ideas/')}>{t('notFound.ideas')}</a>
      <a class="text-link" href={withBase('/contribute/')}>{t('notFound.contribute')}</a>
    </div>
  </section>
</BaseLayout>
