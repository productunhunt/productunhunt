---
// The idea page (§7): a serious editorial profile with the judgement at the
// end. The section order below is the spec's, in order — kicker, name,
// tagline, byline, editor stamp, mood teaser, roast, poll, house rules,
// comments, kindred ideas, set one free.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import Comments from '../../components/Comments.astro';
import Poll from '../../components/Poll.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StructuredData from '../../components/StructuredData.astro';
import VoteSummary from '../../components/VoteSummary.astro';
import { withBase } from '../../lib/url';
import { getPublishedIdeas, byNewest } from '../../lib/ideas';
import { tagSlug } from '../../lib/tags';
import { STATUS_LABEL } from '../../lib/status';
import { CONTACT_EMAIL, REPO_URL, SITE } from '../../consts';
import { t } from '../../i18n';

export const getStaticPaths = (async () => {
  const ideas = await getPublishedIdeas();
  return ideas.map((idea) => ({
    params: { slug: idea.id },
    // The siblings travel as a prop so the page doesn't re-read the collection
    // once per idea just to work out what else is nearby.
    props: { idea, siblings: ideas.filter((other) => other.id !== idea.id) },
  }));
}) satisfies GetStaticPaths;

// `Astro.props` is inferred from `getStaticPaths` above — an explicit `Props`
// interface here would only be a second, driftable copy of the same shape.
const { idea, siblings } = Astro.props;
const {
  title,
  tagline,
  author,
  status,
  tags,
  editorStamp,
  relapse,
} = idea.data;

const { Content, headings } = await render(idea);

// §7: "Keel TOC only if a roast is actually long." Five `##` headings is the
// floor every idea has to clear (`check:ideas` enforces them), so a table of
// contents only earns its space once there are more than that.
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const showToc = tocHeadings.length > 5;

// "Kindred ideas" (§7): most shared tags first, newest as the tie-break.
const related = siblings
  .map((other) => ({
    idea: other,
    shared: other.data.tags.filter((tag) => (tags as readonly string[]).includes(tag)).length,
  }))
  .filter((candidate) => candidate.shared > 0)
  .sort((a, b) => b.shared - a.shared || byNewest(a.idea, b.idea))
  .slice(0, 3)
  .map((candidate) => candidate.idea);

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(withBase(`/ideas/${idea.id}/`), site).href;
const ogImage = withBase(`/og/ideas/${idea.id}.png`);

// §12: JSON-LD describes an article about a fictional, abandoned product, and
// the author comes from frontmatter — never `SITE.author`, which is the house
// byline and would misattribute every community submission.
const authorUrl =
  author.url ??
  (author.github
    ? `https://github.com/${encodeURIComponent(author.github.replace(/^@/, ''))}`
    : undefined);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: tagline,
  datePublished: idea.data.publishDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author.name,
    ...(author.title ? { jobTitle: author.title } : {}),
    ...(authorUrl ? { url: authorUrl } : {}),
  },
  publisher: { '@type': 'Organization', name: SITE.title, url: new URL(withBase('/'), site).href },
  mainEntityOfPage: canonical,
  image: new URL(ogImage, site).href,
  keywords: tags.join(', '),
  // The subject is the product, which does not and will not exist.
  about: { '@type': 'Product', name: title, description: tagline },
  creativeWorkStatus: STATUS_LABEL[status],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('idea.breadcrumbHome'),
      item: new URL(withBase('/'), site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('idea.breadcrumbIdeas'),
      item: new URL(withBase('/ideas/'), site).href,
    },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---

<BaseLayout title={title} description={tagline} ogType="article" image={ogImage}>
  <StructuredData slot="head" schema={[articleSchema, breadcrumbSchema]} />

  <article>
    <header class="section article-head idea-head">
      <a class="idea-back" href={withBase('/ideas/')}
        ><span aria-hidden="true">←</span> Back to the pile</a
      >

      <div class="idea-hero-grid">
        <div class="idea-hero-main">
          <p class="idea-kicker">
            <StatusBadge status={status} />
            <span class="idea-kicker-tags">
              {tags.map((tag) => <a href={withBase(`/ideas/tags/${tagSlug(tag)}/`)}>{tag}</a>)}
            </span>
          </p>
          <h1>{title}</h1>
          <p class="lead idea-tagline">{tagline}</p>
          <p class="idea-disclaimer">
            <span>Founder note</span>
            {
              relapse
                ? 'This was satire. Then it wasn’t. The pitch deck reopened itself.'
                : 'This is satire. Please close the pitch deck.'
            }
          </p>
        </div>

        <aside class="idea-dossier" aria-label="Idea case file">
          <p class="dossier-label">CASE FILE / {idea.id.toUpperCase()}</p>
          {
            editorStamp && (
              <div class="editor-stamp">
                <p class="eyebrow">{t('idea.editorStampEyebrow')}</p>
                <p>{editorStamp}</p>
              </div>
            )
          }
          {
            relapse && (
              <div class="relapse-evidence">
                <p class="eyebrow">{t('relapse.eyebrow')}</p>
                <p>{t(`relapse.extent.${relapse.extent}`)}</p>
                {/* Citing evidence, not passing SEO juice to our own products. */}
                <a href={relapse.url} rel="nofollow noopener noreferrer" target="_blank">
                  {t('relapse.visit')}
                </a>
              </div>
            )
          }
          <div class="mood-teaser">
            <p class="eyebrow">{t('idea.moodEyebrow')}</p>
            <VoteSummary slug={idea.id} top={1} showRemainder={false} class="mood-value" />
          </div>
          <AuthorCard author={author} />
        </aside>
      </div>
    </header>

    {/* 7. The roast */}
    <div class:list={['section', 'roast-section', showToc && 'article-layout']}>
      <div class="roast-flag" aria-hidden="true">
        <span>THE ROAST</span>
        <small>Read time: shorter than the investor update</small>
      </div>
      {
        showToc && (
          <aside class="article-toc" aria-label={t('idea.tocLabel')} data-pagefind-ignore>
            <p class="eyebrow">{t('idea.contentsEyebrow')}</p>
            <nav>
              {tocHeadings.map((heading) => (
                <a href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>

    {/* 8. Community verdict — all six options with counts and a thin bar. */}
    <section class="section poll-section" aria-label="Community verdict">
      <p class="eyebrow poll-eyebrow">{t('poll.heading')}</p>
      <Poll slug={idea.id} />
    </section>

    {/* 9. House rules */}
    <section class="section house-rules" aria-labelledby="house-rules-heading">
      <p class="eyebrow" id="house-rules-heading">{t('houseRules.eyebrow')}</p>
      <ul aria-label={t('houseRules.label')}>
        <li>{t('houseRules.one')}</li>
        <li>{t('houseRules.two')}</li>
      </ul>
    </section>

    {/* 10. Comments — no-ops entirely while GISCUS.enabled is false */}
    <Comments />

    {/* 11. Kindred ideas */}
    {
      related.length > 0 && (
        <section
          class="section post-nav-section"
          aria-labelledby="related-heading"
          data-pagefind-ignore
        >
          <p class="eyebrow" id="related-heading">
            {t('idea.relatedEyebrow')}
          </p>
          <ul class="related-list" aria-label={t('idea.relatedLabel')}>
            {related.map((other) => (
              <li>
                <a href={withBase(`/ideas/${other.id}/`)}>{other.data.title}</a>
                <p>{other.data.tagline}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* 12. Set one free */}
    <section class="section submit-worse" aria-labelledby="submit-heading" data-pagefind-ignore>
      <p class="eyebrow" id="submit-heading">{t('idea.submitEyebrow')}</p>
      <h2>You have one of these too. Set it free.</h2>
      <div class="action-row">
        <a class="button" href={withBase('/contribute/')}>{t('cta.submit')}</a>
        <a class="text-link" href={`${REPO_URL}/pulls`} rel="noopener noreferrer" target="_blank">
          Open a pull request ↗
        </a>
        <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </div>
    </section>
  </article>
</BaseLayout>
