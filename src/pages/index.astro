---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { withBase } from '../lib/url';
import { getPublishedIdeas } from '../lib/ideas';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

// Phase 4 rewrites this page to the §5 layout (hero, filter row, the three
// card modules, featured interstitial). For now it is a thin bridge that keeps
// the homepage rendering off the new collection.
const ideas = (await getPublishedIdeas()).slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">Ideas, correctly abandoned</p>
    <h1>{SITE.description}</h1>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/contribute/')}>{t('cta.submit')}</a>
      <a class="text-link" href={withBase('/how-it-works/')}>{t('cta.howThisWorks')}</a>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-ideas">
    <div class="section-heading">
      <p class="eyebrow">{t('ideas.eyebrow')}</p>
      <h2 id="latest-ideas">{t('home.recentlyNotBuilt')}</h2>
      <a class="text-link" href={withBase('/ideas/')}>{t('cta.fullPile')}</a>
    </div>

    {
      ideas.length > 0 ? (
        <div class="note-list">
          {ideas.map((idea) => (
            <article class="note-row">
              <div>
                <p class="meta">{formatDate(idea.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/ideas/${idea.id}/`)}>{idea.data.title}</a>
                </h3>
                <p>{idea.data.tagline}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>{t('home.empty')}</p>
        </div>
      )
    }
  </section>
</BaseLayout>
