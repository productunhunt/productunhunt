---
// The show (§5): manifesto 20%, ideas 70%, contribute 10%. The hero is short
// on purpose — the first card has to explain the site without another
// paragraph, so nothing stands between the manifesto line and the pile.
import BaseLayout from '../layouts/BaseLayout.astro';
import IdeaList from '../components/IdeaList.astro';
import Interstitial from '../components/Interstitial.astro';
import StructuredData from '../components/StructuredData.astro';
import TagFilter from '../components/TagFilter.astro';
import { withBase } from '../lib/url';
import { getPublishedIdeas } from '../lib/ideas';
import { usedTags } from '../lib/tags';
import { CONTACT_EMAIL, REPO_URL, SITE } from '../consts';
import { t } from '../i18n';

const ideas = await getPublishedIdeas();
const tags = usedTags(ideas);

// Three modules of three, newest first. Each block renders only if it has
// something in it, so a young pile is a short page rather than a page of
// headings over empty grids.
const firstBlock = ideas.slice(0, 3);
const secondBlock = ideas.slice(3, 6);
const thirdBlock = ideas.slice(6, 9);

// §13: the featured module is manual and stays hidden until community entries
// start arriving. With every house idea shipping `featured: false`, this is
// empty and the interstitial never renders.
const featured = ideas.filter((idea) => idea.data.featured);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <section class="hero section">
    <div class="hero-copy">
      <p class="hero-kicker">
        <span aria-hidden="true">●</span> No waitlist. No product. No problem.
      </p>
      <h1>Where bad ideas come to <em>die beautifully.</em></h1>
      <p class="hero-lead">
        A launch platform for products that should never launch. Read the pitch, enjoy the delusion,
        and help deliver the final verdict.
      </p>
      <div class="action-row" aria-label={t('home.primaryLinks')}>
        <a class="button hero-primary" href="#recently-not-built"
          >Browse the wreckage <span>↓</span></a
        >
        <a class="button button-ghost" href={withBase('/contribute/')}>Submit your worst idea</a>
      </div>
      <div class="hero-proof" aria-label="ProductUnhunt in numbers">
        <p><strong>{ideas.length}</strong><span>ideas spared<br />from production</span></p>
        <p><strong>$0</strong><span>venture capital<br />needlessly deployed</span></p>
        <p><strong>100%</strong><span>pre-revenue,<br />post-common sense</span></p>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="hero-orbit orbit-one">BAD<br />IDEA</div>
      <div class="hero-orbit orbit-two">SHIPN'T</div>
      <div class="hero-image-wrap">
        <img src={withBase('/productunhunt-rocket.webp')} alt="" width="1024" height="1536" />
      </div>
      <span class="hero-sticker sticker-top">0% VC BACKED</span>
      <span class="hero-sticker sticker-bottom">PROUDLY<br />PRE-LAUNCH</span>
    </div>
  </section>

  <div class="unhunt-ticker" aria-hidden="true">
    <div>
      <span>✦ Ideas nobody asked for</span><span>✦ Due diligence by vibes</span><span
        >✦ Zero users affected</span
      ><span>✦ Now disrupting absolutely nothing</span><span>✦ Ideas nobody asked for</span><span
        >✦ Due diligence by vibes</span
      ><span>✦ Zero users affected</span><span>✦ Now disrupting absolutely nothing</span>
    </div>
  </div>

  <section class="section index-feed" aria-labelledby="recently-not-built">
    <div class="section-heading">
      <p class="eyebrow">Freshly abandoned</p>
      <h2 id="recently-not-built">The latest <em>non-launches.</em></h2>
      <a class="text-link" href={withBase('/ideas/')}>{t('cta.fullPile')}</a>
    </div>

    <TagFilter tags={tags} />

    <IdeaList ideas={firstBlock} label={t('ideas.listLabel')} empty={t('home.empty')} />
  </section>

  {
    featured.length > 0 && (
      <Interstitial
        class="featured-interstitial"
        eyebrow={t('ideas.eyebrow')}
        heading={t('home.featuredHeading')}
        headingId="featured-heading"
      >
        <IdeaList ideas={featured.slice(0, 3)} label={t('home.featuredHeading')} />
      </Interstitial>
    )
  }

  {
    secondBlock.length > 0 && (
      <section class="section" aria-label={t('ideas.listLabel')}>
        <IdeaList ideas={secondBlock} label={t('ideas.listLabel')} />
      </section>
    )
  }

  <Interstitial
    class="contribute-interstitial"
    layout="split"
    eyebrow={t('contribute.eyebrow')}
    heading={t('home.contributeHeading')}
    headingId="contribute-heading"
  >
    <p>{t('home.contributeLead')}</p>
    <div class="action-row">
      <a class="button" href={withBase('/contribute/')}>{t('cta.submit')}</a>
      <a class="text-link" href={`${REPO_URL}/pulls`} rel="noopener noreferrer" target="_blank">
        Open a pull request ↗
      </a>
      <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </Interstitial>

  {
    thirdBlock.length > 0 && (
      <section class="section" aria-label={t('ideas.listLabel')}>
        <IdeaList ideas={thirdBlock} label={t('ideas.listLabel')} />
      </section>
    )
  }

  <section class="section pile-link">
    <a class="text-link" href={withBase('/ideas/')}>{t('cta.fullPile')} →</a>
  </section>
</BaseLayout>
