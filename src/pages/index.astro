---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { withBase } from '../lib/url';
import { getPublishedIdeas } from '../lib/ideas';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

// Phase 4 rewrites this page to the §5 layout (hero, filter row, the three
// card modules, featured interstitial). For now it is a thin bridge that keeps
// the homepage rendering off the new collection.
const ideas = (await getPublishedIdeas()).slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">Portfolio / writing / systems notes</p>
    <h1>Structural minimalism for careful digital work.</h1>
    <p class="lead">
      Astro Keel gives projects, essays, and professional notes a disciplined frame: editorial type,
      measured rhythm, and a single accent carried through fine structural rules.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/ideas/')}>{t('home.viewWorks')}</a>
      <a class="text-link" href={withBase('/about/')}>{t('home.readNotes')}</a>
    </div>
  </section>

  <section class="section split-overview" aria-label={t('home.overviewLabel')}>
    <div>
      <p class="eyebrow">Principles</p>
      <h2>Readable first, decorative last.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Baseline rhythm</h3>
        <p>Vertical spacing follows a steady cadence for long-form reading.</p>
      </article>
      <article>
        <h3>Typed content</h3>
        <p>Collections are prepared for project case studies and durable notes.</p>
      </article>
      <article>
        <h3>Keel lines</h3>
        <p>Fine rules create structure without relying on decorative effects.</p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-ideas">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-ideas">Recently not built.</h2>
      <a class="text-link" href={withBase('/ideas/')}>{t('home.allPosts')}</a>
    </div>

    {
      ideas.length > 0 ? (
        <div class="note-list">
          {ideas.map((idea) => (
            <article class="note-row">
              <div>
                <p class="meta">{formatDate(idea.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/ideas/${idea.id}/`)}>{idea.data.title}</a>
                </h3>
                <p>{idea.data.tagline}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>
