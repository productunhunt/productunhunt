---
// The show (§5): manifesto 20%, ideas 70%, contribute 10%. The hero is short
// on purpose — the first card has to explain the site without another
// paragraph, so nothing stands between the manifesto line and the pile.
import BaseLayout from '../layouts/BaseLayout.astro';
import IdeaList from '../components/IdeaList.astro';
import Interstitial from '../components/Interstitial.astro';
import StructuredData from '../components/StructuredData.astro';
import TagFilter from '../components/TagFilter.astro';
import { withBase } from '../lib/url';
import { getPublishedIdeas } from '../lib/ideas';
import { usedTags } from '../lib/tags';
import { CONTACT_EMAIL, REPO_URL, SITE } from '../consts';
import { t } from '../i18n';

const ideas = await getPublishedIdeas();
const tags = usedTags(ideas);

// Three modules of three, newest first. Each block renders only if it has
// something in it, so a young pile is a short page rather than a page of
// headings over empty grids.
const firstBlock = ideas.slice(0, 3);
const secondBlock = ideas.slice(3, 6);
const thirdBlock = ideas.slice(6, 9);

// §13: the featured module is manual and stays hidden until community entries
// start arriving. With every house idea shipping `featured: false`, this is
// empty and the interstitial never renders.
const featured = ideas.filter((idea) => idea.data.featured);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <section class="hero section">
    <p class="eyebrow">Ideas, correctly abandoned</p>
    <h1>{SITE.description}</h1>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/contribute/')}>{t('cta.submit')}</a>
      <a class="text-link" href={withBase('/how-it-works/')}>{t('cta.howThisWorks')}</a>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="recently-not-built">
    <div class="section-heading">
      <p class="eyebrow">{t('ideas.eyebrow')}</p>
      <h2 id="recently-not-built">{t('home.recentlyNotBuilt')}</h2>
      <a class="text-link" href={withBase('/ideas/')}>{t('cta.fullPile')}</a>
    </div>

    <TagFilter tags={tags} />

    <IdeaList ideas={firstBlock} label={t('ideas.listLabel')} empty={t('home.empty')} />
  </section>

  {
    featured.length > 0 && (
      <Interstitial
        class="featured-interstitial"
        eyebrow={t('ideas.eyebrow')}
        heading={t('home.featuredHeading')}
        headingId="featured-heading"
      >
        <IdeaList ideas={featured.slice(0, 3)} label={t('home.featuredHeading')} />
      </Interstitial>
    )
  }

  {
    secondBlock.length > 0 && (
      <section class="section" aria-label={t('ideas.listLabel')}>
        <IdeaList ideas={secondBlock} label={t('ideas.listLabel')} />
      </section>
    )
  }

  <Interstitial
    class="contribute-interstitial"
    layout="split"
    eyebrow={t('contribute.eyebrow')}
    heading={t('home.contributeHeading')}
    headingId="contribute-heading"
  >
    <p>{t('home.contributeLead')}</p>
    <div class="action-row">
      <a class="button" href={withBase('/contribute/')}>{t('cta.submit')}</a>
      <a class="text-link" href={`${REPO_URL}/pulls`} rel="noopener noreferrer" target="_blank">
        Open a pull request ↗
      </a>
      <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </Interstitial>

  {
    thirdBlock.length > 0 && (
      <section class="section" aria-label={t('ideas.listLabel')}>
        <IdeaList ideas={thirdBlock} label={t('ideas.listLabel')} />
      </section>
    )
  }

  <section class="section pile-link">
    <a class="text-link" href={withBase('/ideas/')}>{t('cta.fullPile')} →</a>
  </section>
</BaseLayout>
