---
// §8's idea-page author card: avatar, name, optional title, optional links,
// optional one-line bio, and how the idea arrived. Pseudonyms are fine and
// every optional field is genuinely optional — most house ideas set only
// `name` and `title`.
import { t } from '../i18n';

interface Props {
  author: {
    name: string;
    title?: string | null;
    x?: string | null;
    github?: string | null;
    url?: string | null;
    bio?: string | null;
    source: 'PR' | 'email';
  };
}

const { author } = Astro.props;

// The schema carries no email, so Gravatar is unreachable by design (§8 lists
// it as an option; the content model rules it out). A GitHub handle gives a
// real avatar; everything else falls back to a generated initial mark.
const handle = author.github?.replace(/^@/, '');
const avatarUrl = handle ? `https://github.com/${encodeURIComponent(handle)}.png?size=96` : null;
const initial = [...author.name.trim()][0]?.toUpperCase() ?? '?';

const xHandle = author.x?.replace(/^@/, '');
const links = [
  xHandle && { label: `@${xHandle}`, href: `https://x.com/${encodeURIComponent(xHandle)}` },
  handle && { label: `github/${handle}`, href: `https://github.com/${encodeURIComponent(handle)}` },
  author.url && { label: 'Site', href: author.url },
].filter((link): link is { label: string; href: string } => Boolean(link));

const sourceLabel =
  author.source === 'email' ? t('idea.authorSourceEmail') : t('idea.authorSourcePR');
---

<div class="author-card">
  {
    avatarUrl ? (
      <img
        class="author-avatar"
        src={avatarUrl}
        alt=""
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="author-avatar is-generated" aria-hidden="true">
        {initial}
      </span>
    )
  }
  <div class="author-body">
    <p class="author-name">
      {author.name}
      {author.title && <span class="author-title">{author.title}</span>}
    </p>
    {author.bio && <p class="author-bio">{author.bio}</p>}
    {
      links.length > 0 && (
        <p class="author-links">
          {links.map((link) => (
            <a href={link.href} rel="noopener noreferrer nofollow" target="_blank">
              {link.label}
            </a>
          ))}
        </p>
      )
    }
    <p class="author-source">{sourceLabel}</p>
  </div>
</div>
