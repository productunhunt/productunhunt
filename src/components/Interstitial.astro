---
// The homepage's between-the-cards modules (§5): "Most gloriously impractical this week"
// and "You have ideas like these too". Two shapes, one frame — `split` puts the
// heading opposite the body on the `.prose-grid` rhythm, `stack` runs the
// body full width under it.
interface Props {
  eyebrow: string;
  heading: string;
  /** Id for the heading, referenced by the section's `aria-labelledby`. */
  headingId: string;
  layout?: 'stack' | 'split';
  class?: string;
}

const { eyebrow, heading, headingId, layout = 'stack', class: className } = Astro.props;
---

<section class:list={['section', 'interstitial', className]} aria-labelledby={headingId}>
  {
    layout === 'split' ? (
      <div class="prose-grid">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h2 id={headingId}>{heading}</h2>
        </div>
        <div class="prose-stack">
          <slot />
        </div>
      </div>
    ) : (
      <>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id={headingId}>{heading}</h2>
        <slot />
      </>
    )
  }
</section>
